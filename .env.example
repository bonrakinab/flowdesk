# Database (Neon Postgres — required for Vercel)
# Use the pooled connection for DATABASE_URL and the direct one for DIRECT_URL (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"
# Set to your production URL after deploy, e.g. https://flowdesk.vercel.app
AUTH_URL="http://localhost:3000"

# Optional Google OAuth (add production callback in Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Web push
ENABLE_PWA_DEV=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Background alert tick / Vercel Cron
CRON_SECRET=

# SMTP — pick ONE style:
# SMTP_URL=smtp://USER:APP_PASSWORD@smtp.gmail.com:587
# SMTP_FROM=Flowdesk <you@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=false
# SMTP_FROM=Flowdesk <you@gmail.com>

# SMS alerts (Twilio) — optional
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567

# Android Capacitor shell (read at npm run android:sync)
# FLOWDESK_URL=https://your-app.vercel.app

# In-app Agent (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; default gemini-3.6-flash (smarter than Flash-Lite)
# GEMINI_MODEL=gemini-3.6-flash

# Merriam-Webster Collegiate Dictionary (Poems dictionary) — https://dictionaryapi.com
# MERRIAM_WEBSTER_DICTIONARY_KEY=
