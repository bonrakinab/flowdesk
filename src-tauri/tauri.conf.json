{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowdesk",
  "version": "0.1.0",
  "identifier": "com.arnobbanik.flowdesk",
  "build": {
    "frontendDist": "https://flowdesk-rose.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flowdesk",
        "url": "https://flowdesk-rose.vercel.app/today",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": true,
        "focus": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Flowdesk personal productivity workspace for Windows",
    "longDescription": "Flowdesk brings tasks, tickets, calendar, notes, fitness, health, reminders, finance and personal organization into a dedicated Windows desktop application.",
    "icon": ["../public/favicon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true
    }
  }
}
